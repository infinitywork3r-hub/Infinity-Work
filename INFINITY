function detectPlatform(url){
  if(!url) return 'other';
  if(/youtube\.com|youtu\.be/.test(url)) return 'youtube';
  if(/vimeo\.com/.test(url)) return 'vimeo';
  return 'other';
}
function extractYouTubeId(url){
  const m = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([\w-]{6,})/);
  return m ? m[1] : null;
}
function extractVimeoId(url){
  const m = url.match(/vimeo\.com\/(\d+)/);
  return m ? m[1] : null;
}
function toEmbedUrl(url){
  if(!url) return '';
  url = url.trim();
  const platform = detectPlatform(url);
  if(platform === 'youtube'){ const id = extractYouTubeId(url); return id ? `https://www.youtube.com/embed/${id}` : ''; }
  if(platform === 'vimeo'){ const id = extractVimeoId(url); return id ? `https://player.vimeo.com/video/${id}` : ''; }
  return url;
}

let ytApiReadyPromise = null;
function loadYouTubeAPI(){
  if(window.YT && window.YT.Player) return Promise.resolve();
  if(ytApiReadyPromise) return ytApiReadyPromise;
  ytApiReadyPromise = new Promise(resolve => { window.onYouTubeIframeAPIReady = resolve; });
  return ytApiReadyPromise;
}

let currentPlayer = null;
let currentPlayerLessonId = null;
let progressTimer = null;

function stopProgressTracking(){
  if(progressTimer){ clearInterval(progressTimer); progressTimer = null; }
  currentPlayer = null;
  currentPlayerLessonId = null;
}

async function trackTick(){
  if(!currentPlayer || !currentPlayerLessonId) return;
  try{
    const seconds = await currentPlayer.getCurrentTime();
    const duration = await currentPlayer.getDuration();
    if(duration > 0){
      saveProgress(currentPlayerLessonId, seconds, duration);
      updateProgressBar(currentPlayerLessonId, seconds, duration);
      refreshCertAction();
    }
  }catch(e){}
}

function refreshCertAction(){
  if(!clientDetailCourseId) return;
  const c = state.courses.find(x=>x.id===clientDetailCourseId);
  if(!c) return;
  const done = state.completions[session.id] || [];
  const isDone = done.includes(clientDetailCourseId);
  const status = state.certStatus[clientDetailCourseId];
  const wrap = document.querySelector('#client-detail-body > div[style*="border-top"]');
  if(!wrap) return;
  if(isDone){
    wrap.innerHTML = status === 'approved'
      ? `<button class="btn btn-ghost btn-sm" onclick="openCertificate('${clientDetailCourseId}')">Descargar certificado</button>`
      : `<span style="font-family:'Montserrat';font-size:11px;color:var(--signal);">Certificado en revisión por el asesor</span>`;
  } else if(courseFullyWatched(clientDetailCourseId)){
    wrap.innerHTML = `<button class="btn btn-solid btn-sm" onclick="requestCertificate('${clientDetailCourseId}')">Generar certificado</button>`;
  }
}

async function saveProgress(lessonId, seconds, duration){
  if(!session) return;
  state.progress = state.progress || {};
  state.progress[lessonId] = { seconds, duration };
  try{
    await sb.from('lesson_progress').upsert({ user_id: session.id, lesson_id: lessonId, seconds, duration, updated_at: new Date().toISOString() });
  }catch(e){ console.error(e); }
}

function updateProgressBar(lessonId, seconds, duration){
  const pct = duration > 0 ? Math.min(100, (seconds/duration*100)) : 0;
  const fill = document.querySelector(`.lesson-item[data-lesson="${lessonId}"] .lesson-progress-fill`);
  if(fill) fill.style.width = pct.toFixed(1) + '%';
}

async function selectLesson(slot, lessonId){
  const courseId = slot === 'detail' ? clientDetailCourseId : slot;
  const lessons = (state.lessons && state.lessons[courseId]) || [];
  const l = lessons.find(x=>x.id===lessonId);
  const playerBox = document.getElementById('lesson-player-'+slot);
  if(!l || !playerBox) return;

  const sidebar = document.getElementById('lesson-sidebar-'+slot);
  if(sidebar){
    sidebar.querySelectorAll('.lesson-item').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-lesson') === lessonId);
    });
  }

  stopProgressTracking();
  currentPlayerLessonId = lessonId;
  const saved = state.progress && state.progress[lessonId];
  const startSeconds = saved && saved.duration && (saved.seconds < saved.duration - 3) ? saved.seconds : 0;
  const platform = detectPlatform(l.video_url);
  const materials = (state.materials && state.materials[lessonId]) || [];
  const materialHtml = materials.length
    ? `<div style="margin-top:10px;display:flex;flex-wrap:wrap;gap:8px;">${materials.map(m => `<a href="${escapeHtml(m.url)}" target="_blank" rel="noopener" class="btn btn-ghost btn-sm">Descargar: ${escapeHtml(m.name || 'material')}</a>`).join('')}</div>`
    : '';

  if(platform === 'youtube'){
    const vid = extractYouTubeId(l.video_url);
    if(!vid){ playerBox.innerHTML = `<div style="font-size:12.5px;color:var(--paper-dim)">Esta clase todavía no tiene video.</div>${materialHtml}`; return; }
    playerBox.innerHTML = `<div style="position:relative;padding-top:56.25%;"><div id="ytp-${lessonId}" style="position:absolute;top:0;left:0;width:100%;height:100%;"></div></div>${materialHtml}`;
    await loadYouTubeAPI();
    currentPlayer = new YT.Player(`ytp-${lessonId}`, {
      videoId: vid,
      playerVars: { start: Math.floor(startSeconds) },
      events: {
        onReady: () => {
          progressTimer = setInterval(trackTick, 5000);
        },
        onStateChange: (e) => {
          if(e.data === YT.PlayerState.PAUSED || e.data === YT.PlayerState.ENDED) trackTick();
        }
      }
    });
  } else if(platform === 'vimeo'){
    const vid = extractVimeoId(l.video_url);
    if(!vid){ playerBox.innerHTML = `<div style="font-size:12.5px;color:var(--paper-dim)">Esta clase todavía no tiene video.</div>${materialHtml}`; return; }
    playerBox.innerHTML = `<div style="position:relative;padding-top:56.25%;"><iframe id="vmp-${lessonId}" src="https://player.vimeo.com/video/${vid}" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe></div>${materialHtml}`;
    currentPlayer = new Vimeo.Player(document.getElementById(`vmp-${lessonId}`));
    currentPlayer.ready().then(() => {
      if(startSeconds > 1) currentPlayer.setCurrentTime(startSeconds);
      progressTimer = setInterval(trackTick, 5000);
      currentPlayer.on('pause', trackTick);
      currentPlayer.on('ended', trackTick);
    });
  } else {
    playerBox.innerHTML = `<div style="position:relative;padding-top:56.25%;">
      <iframe src="${escapeHtml(l.video_url)}" style="position:absolute;top:0;left:0;width:100%;height:100%;border:0;" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
    </div>${materialHtml}`;
  }
}

function genCertCode(){
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
  const seg = n => Array.from({length:n}, () => chars[Math.floor(Math.random()*chars.length)]).join('');
  return `IW-${seg(4)}-${seg(4)}`;
}

