    return;
  }

  box.innerHTML = `
    <div style="margin-bottom:4px;">
      <div class="sheet-code mono">${escapeHtml(c.code)}</div>
      <h3 style="font-size:22px;">${escapeHtml(c.title)}</h3>
    </div>
    ${tabsHtml}
    ${zoomHtml}
