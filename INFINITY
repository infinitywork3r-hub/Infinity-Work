function courseProgressPct(courseId){
  const lessons = (state.lessons && state.lessons[courseId]) || [];
  if(lessons.length === 0) return 0;
  let sum = 0;
  lessons.forEach(l => {
    const p = state.progress && state.progress[l.id];
    if(p && p.duration > 0) sum += Math.min(1, p.seconds / p.duration);
  });
  return Math.round((sum / lessons.length) * 100);
}

