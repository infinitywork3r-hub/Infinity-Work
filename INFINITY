function openCertificate(id){
  const c = state.courses.find(x=>x.id===id);
  const rawDate = state.completionDates[id];
  const dateStr = rawDate ? new Date(rawDate).toLocaleDateString('es-PE', { year:'numeric', month:'long', day:'numeric' }) : '';
  const code = state.certCodes[id] || '';
  const lessons = (state.lessons && state.lessons[id]) || [];
  const { html, verifyUrl } = buildCertificateHTML(session.name, c.title, c.code, c.hours, dateStr, code, lessons, c.instructor);
  document.getElementById('cert-content').innerHTML = html;
  document.getElementById('cert-overlay').classList.remove('hidden');
  const qrBox = document.getElementById('cert-qr');
  if(qrBox && code && window.QRCode){
    qrBox.innerHTML = '';
    new QRCode(qrBox, { text: verifyUrl, width: 88, height: 88, colorDark:'#0B1420', colorLight:'#FFFFFF', correctLevel: QRCode.CorrectLevel.M });
  }
}
