async function doLogin(){
  const email = document.getElementById('li-email').value.trim().toLowerCase();
  const pass = document.getElementById('li-pass').value;
  const msg = document.getElementById('li-msg');
  if(!sb){
    msg.className = 'form-msg err';
    msg.textContent = 'Falta configurar SUPABASE_URL / SUPABASE_ANON_KEY en el código (revisa que la URL empiece con https://).';
    return;
  }
  msg.className = 'form-msg';
  msg.textContent = 'Ingresando…';
  try{
    const { error } = await sb.auth.signInWithPassword({ email, password: pass });
    if(error){ msg.textContent = error.message; msg.className = 'form-msg err'; return; }
    await loadSession();
    closeAuth();
    await renderAll();
  }catch(err){
    console.error(err);
    msg.className = 'form-msg err';
    msg.textContent = 'No se pudo conectar: ' + (err && err.message ? err.message : 'revisa SUPABASE_URL y SUPABASE_ANON_KEY en el código.');
  }
}

async function doRegister(){
