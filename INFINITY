function setAdminTab(tab){
  adminTab = tab;
  document.getElementById('atab-clients').classList.toggle('active', tab==='clients');
  document.getElementById('atab-courses').classList.toggle('active', tab==='courses');
  document.getElementById('atab-projects').classList.toggle('active', tab==='projects');
  document.getElementById('atab-promos').classList.toggle('active', tab==='promos');
  document.getElementById('atab-settings').classList.toggle('active', tab==='settings');
  const actTab = document.querySelector('.admin-tab.active');
  if(actTab && actTab.parentElement){
    const strip = actTab.parentElement;
    const left = actTab.getBoundingClientRect().left - strip.getBoundingClientRect().left + strip.scrollLeft - 14;
    if(strip.scrollTo) strip.scrollTo({ left: Math.max(0, left), behavior: 'smooth' });
  }
  document.getElementById('admin-clients-panel').classList.toggle('hidden', tab!=='clients');
  document.getElementById('admin-courses-panel').classList.toggle('hidden', tab!=='courses');
  document.getElementById('admin-projects-panel').classList.toggle('hidden', tab!=='projects');
  document.getElementById('admin-promos-panel').classList.toggle('hidden', tab!=='promos');
  document.getElementById('admin-settings-panel').classList.toggle('hidden', tab!=='settings');
  if(tab==='projects') renderProjectsAdmin();
  if(tab==='promos') renderPromosAdmin();
  if(tab==='courses') renderCategoriesAdmin();
  if(tab==='settings') renderSettingsAdmin();
}

