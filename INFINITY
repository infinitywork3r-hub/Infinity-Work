<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>INFINITY WORK</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,700;1,800;1,900&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0B1420;
    --ink2:#101B29;
    --ink3:#17263A;
    --paper:#EDF1F6;
    --paper-dim:#8B99AC;
    --line:#1D9BFF;
    --cyan:#06C8F8;
    --line-dim:#1B2A3D;
    --signal:#F2A900;
    --signal-dim:#7A4F04;
    --success:#3FA796;
    --white:#FFFFFF;
    --radius:2px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;overflow-x:hidden;}
  body{
    margin:0;
    overflow-x:hidden;
    width:100%;
    background:var(--ink);
    color:var(--paper);
    font-family:'Montserrat',sans-serif;
  }
  h1,h2,h3,.display{
    font-family:'Montserrat',sans-serif;
    letter-spacing:-0.01em;
    font-weight:800;
    line-height:1.15;
    margin:0;
  }
  h1{text-transform:uppercase;font-style:italic;}
  .mono{font-family:'Montserrat',sans-serif;}
  a{color:inherit;}
  button{font-family:'Montserrat',sans-serif;cursor:pointer;}
  :focus-visible{outline:2px solid var(--line);outline-offset:2px;}

  /* ---- layout shells ---- */
  .wrap{max-width:1360px;margin:0 auto;padding:0 24px;}
  .hidden{display:none !important;}

  /* ---- top notice ---- */
  .notice{
    background:var(--signal);
    color:var(--ink);
    font-family:'Montserrat',sans-serif;
    font-size:12.5px;
    text-align:center;
    padding:8px 16px;
    letter-spacing:0.21px;
  }

  /* ---- header ---- */
  header{
    position:sticky;top:0;z-index:40;
    background:rgba(11,20,32,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line-dim);
  }
  .navbar{display:flex;align-items:center;justify-content:space-between;padding:14px 24px;}
  .logo{display:flex;align-items:center;gap:10px;}
  .logo-mark-img{height:48px;width:auto;display:block;flex:none;}
  .b-word{display:flex;flex-direction:column;font-family:'Montserrat',sans-serif;font-weight:900;line-height:.9;letter-spacing:.01em;white-space:nowrap;text-transform:none;}
  .b-word .w1{color:#fff;font-size:17px;}
  .b-word .w2{color:var(--cyan);font-size:21.5px;margin-left:2px;}
  footer .logo-mark-img{height:54px;}
  footer .b-word .w1{font-size:19px;}
  footer .b-word .w2{font-size:24px;}
  nav{display:flex;align-items:center;gap:28px;}
  nav a{font-size:14px;text-decoration:none;color:var(--paper-dim);border-bottom:1px solid transparent;padding-bottom:2px;transition:color .15s;}
  nav a:hover{color:var(--paper);}
  .menu-toggle{
    display:none;background:none;border:1px solid var(--line-dim);color:var(--paper);
    width:38px;height:38px;font-size:16px;line-height:1;border-radius:var(--radius);
  }
  .btn{
    border:1px solid var(--line);
    background:transparent;color:var(--paper);
    padding:9px 18px;font-size:13px;font-weight:600;
    letter-spacing:0.3px;border-radius:var(--radius);
    transition:all .15s;
  }
  .btn:hover{background:var(--line);color:var(--ink);}
  .btn-solid{background:var(--line);border-color:var(--line);color:var(--ink);font-weight:700;}
  .btn-solid:hover{background:#1580D6;border-color:#1580D6;}
  .btn-ghost{border-color:var(--line-dim);color:var(--paper-dim);}
  .btn-sm{padding:6px 12px;font-size:12px;}
  .btn-danger{border-color:var(--signal-dim);color:var(--signal);}
  .btn-danger:hover{background:var(--signal-dim);color:var(--white);}

  /* ---- hero ---- */
  .hero{padding:88px 0 64px;position:relative;overflow:hidden;}
  .eyebrow{
    font-family:'Montserrat';font-size:12px;color:var(--line);
    letter-spacing:2.1px;text-transform:uppercase;margin-bottom:18px;
    display:flex;align-items:center;gap:10px;
  }
  .eyebrow::before{content:'';width:26px;height:1px;background:var(--line);}
  .hero h1{font-size:clamp(34px,4.8vw,62px);line-height:1.06;max-width:900px;}
  .hero h1 em{font-style:italic;color:var(--cyan);}
  .hero p{max-width:520px;color:var(--paper-dim);font-size:16px;line-height:1.6;margin:24px 0 32px;}
  .hero-actions{display:flex;gap:14px;flex-wrap:wrap;}
  .corner-tick{position:absolute;width:16px;height:16px;border:1.5px solid var(--line);opacity:0.55;}
  .ct-tl{top:0;left:0;border-right:0;border-bottom:0;}
  .ct-tr{top:0;right:24px;border-left:0;border-bottom:0;}

  /* ---- stats strip ---- */
  .stats{border-top:1px solid var(--line-dim);border-bottom:1px solid var(--line-dim);padding:22px 0;}
  .stats .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;}
  .stat b{font-family:'Montserrat';font-weight:800;font-size:28px;color:var(--line);display:block;}
  .stat span{font-family:'Montserrat';font-size:11px;color:var(--paper-dim);text-transform:uppercase;letter-spacing:0.7px;}

  /* ---- section heads ---- */
  .section{padding:72px 0;}
  .section-head{display:flex;justify-content:space-between;align-items:flex-end;margin-bottom:36px;flex-wrap:wrap;gap:16px;border-bottom:1px solid var(--line-dim);padding-bottom:20px;}
  .section-head h2{font-size:30px;}
  .section-head p{color:var(--paper-dim);font-size:13.5px;max-width:400px;margin-top:6px;}
  .section-tag{font-family:'Montserrat';font-size:11px;color:var(--paper-dim);letter-spacing:0.7px;}

  /* ---- course grid / title-block cards ---- */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));gap:22px;}
  .sheet{
    position:relative;
    background:var(--ink2);
    border:1px solid var(--line-dim);
    padding:20px 20px 0;
    display:flex;flex-direction:column;
    min-height:270px;
  }
  .sheet::before,.sheet::after,.sheet .tick-br,.sheet .tick-bl{content:'';position:absolute;width:12px;height:12px;border:1.5px solid var(--line);opacity:.6;}
  .sheet::before{top:-1px;left:-1px;border-right:0;border-bottom:0;}
  .sheet::after{top:-1px;right:-1px;border-left:0;border-bottom:0;}
  .sheet .tick-bl{bottom:0;left:-1px;border-right:0;border-top:0;}
  .sheet .tick-br{bottom:0;right:-1px;border-left:0;border-top:0;}
  .sheet-code{font-family:'Montserrat';font-size:11.5px;color:var(--line);letter-spacing:0.7px;}
  .sheet h3{font-size:17px;font-weight:700;line-height:1.25;margin:10px 0 12px;}
  .sheet p{font-size:13.5px;color:var(--paper-dim);line-height:1.55;flex:1;}
  .stamp{
    font-family:'Montserrat';font-weight:700;font-size:11px;letter-spacing:1.05px;
    border:2px solid var(--success);color:var(--success);
    padding:4px 10px;display:inline-block;transform:rotate(-6deg);
    mix-blend-mode:multiply;width:fit-content;margin:4px 0 14px;
  }
  .stamp.locked{border-color:var(--signal);color:var(--signal);}
  .title-block{
    display:flex;justify-content:space-between;align-items:center;
    border-top:1px solid var(--line-dim);
    padding:12px 0;margin-top:auto;
    font-family:'Montserrat';font-size:11px;color:var(--paper-dim);
  }
  .title-block b{color:var(--paper);font-weight:600;}

  /* ---- alliances ---- */
  .allies{display:flex;gap:14px;flex-wrap:wrap;}
  .ally-chip{border:1px solid var(--line-dim);padding:14px 18px;font-family:'Montserrat';font-size:12px;color:var(--paper-dim);}

  /* ---- footer ---- */
  footer{border-top:1px solid var(--line-dim);padding:40px 0;margin-top:40px;}
  footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;}
  footer p{font-size:12px;color:var(--paper-dim);font-family:'Montserrat';}

  /* ---- modal ---- */
  .overlay{
    position:fixed;inset:0;background:rgba(6,14,24,0.82);
    display:flex;align-items:center;justify-content:center;z-index:100;padding:20px;
  }
  .modal{
    background:var(--ink2);border:1px solid var(--line);
    width:100%;max-width:400px;padding:30px 28px 28px;position:relative;
  }
  .modal .corner-tick{opacity:.8;}
  .modal-close{position:absolute;top:14px;right:14px;background:none;border:none;color:var(--paper-dim);font-size:20px;line-height:1;padding:4px;}
  .tabs{display:flex;gap:0;margin-bottom:22px;border-bottom:1px solid var(--line-dim);}
  .tab{flex:1;background:none;border:none;color:var(--paper-dim);padding:10px 0;font-size:13px;font-weight:600;letter-spacing:0.3px;border-bottom:2px solid transparent;}
  .tab.active{color:var(--paper);border-color:var(--line);}
  .field{margin-bottom:14px;}
  .field label{display:block;font-family:'Montserrat';font-size:11px;color:var(--paper-dim);letter-spacing:0.7px;text-transform:uppercase;margin-bottom:6px;}
  .field input,.field textarea,.field select{
    width:100%;background:var(--ink);border:1px solid var(--line-dim);color:var(--paper);
    padding:10px 12px;font-size:14px;font-family:'Montserrat';border-radius:var(--radius);
  }
  .field input:focus,.field textarea:focus,.field select:focus{border-color:var(--line);}
  .form-msg{font-size:12.5px;margin-bottom:12px;font-family:'Montserrat';}
  .form-msg.err{color:var(--signal);}
  .form-msg.ok{color:var(--success);}
  .full{width:100%;text-align:center;}
  .btn-google{
    width:100%;display:flex;align-items:center;justify-content:center;gap:10px;
    background:#FFFFFF;border:1px solid var(--line-dim);color:#15181D;
    padding:10px 0;font-size:13.5px;font-weight:600;border-radius:var(--radius);
  }
  .btn-google:hover{background:#F3F6FA;}
  .divider{display:flex;align-items:center;gap:12px;margin:18px 0;font-family:'Montserrat';font-size:10.5px;color:var(--paper-dim);letter-spacing:0.7px;}
  .divider::before,.divider::after{content:'';flex:1;height:1px;background:var(--line-dim);}

  .whatsapp-float{
    position:fixed;bottom:22px;right:22px;z-index:50;
    width:54px;height:54px;border-radius:50%;
    background:#25D366;display:flex;align-items:center;justify-content:center;
    box-shadow:0 4px 14px rgba(0,0,0,0.35);
  }
  .whatsapp-float svg{width:28px;height:28px;}

  .tag-chip{font-family:'Montserrat';font-size:9.5px;letter-spacing:0.35px;border:1px solid var(--line-dim);color:var(--paper-dim);padding:3px 7px;text-transform:uppercase;display:inline-block;margin-bottom:8px;}

  .client-subnav{display:flex;gap:26px;border-bottom:1px solid var(--line-dim);margin:24px 0 28px;}
  .csn-item{background:none;border:none;color:var(--paper-dim);font-family:'Montserrat';font-size:11.5px;letter-spacing:0.7px;text-transform:uppercase;padding:10px 2px;border-bottom:2px solid transparent;}
  .csn-item.active{color:var(--line);border-color:var(--line);}

  /* ---- client sidebar shell ---- */
  .client-shell{display:flex;gap:26px;align-items:flex-start;}
  .client-sidebar{width:226px;flex-shrink:0;background:var(--ink2);border:1px solid var(--line-dim);position:sticky;top:126px;}
  .client-sidebar .csb-user{padding:18px 20px;border-bottom:1px solid var(--line-dim);}
  .client-sidebar .csb-user .nm{font-family:'Montserrat';font-weight:700;font-size:13.5px;color:var(--paper);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .client-sidebar .csb-user .em{font-family:'Montserrat';font-size:10.5px;color:var(--paper-dim);margin-top:2px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
  .client-sidebar .csb-group{padding:16px 0 4px;}
  .client-sidebar .csb-label{font-family:'Montserrat';font-size:9.5px;letter-spacing:1.05px;color:var(--paper-dim);text-transform:uppercase;padding:0 20px;margin-bottom:8px;}
  .csb-item{display:flex;align-items:center;gap:11px;width:100%;background:none;border:none;color:var(--paper-dim);font-family:'Montserrat';font-size:13px;font-weight:500;padding:10px 20px;text-align:left;border-left:2px solid transparent;cursor:pointer;}
  .csb-item svg{width:17px;height:17px;flex-shrink:0;opacity:.75;}
  .csb-item.active{color:var(--line);background:rgba(29,155,255,.08);border-left-color:var(--line);}
  .csb-item.active svg{opacity:1;}
  .csb-item:hover:not(.active){color:var(--paper);}
  .client-main{flex:1;min-width:0;}

  .cstats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:24px;}
  .cstat{background:var(--ink2);border:1px solid var(--line-dim);padding:14px 16px;}
  .cstat b{display:block;font-family:'Montserrat';font-weight:700;font-size:28px;color:var(--line);line-height:1;}
  .cstat span{font-family:'Montserrat';font-size:10px;letter-spacing:0.7px;text-transform:uppercase;color:var(--paper-dim);}

  .cfilters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;}
  .cf-pill{font-family:'Montserrat';font-size:10.5px;letter-spacing:0.35px;text-transform:uppercase;padding:8px 15px;border:1px solid var(--line-dim);color:var(--paper-dim);background:none;cursor:pointer;}
  .cf-pill.active{background:var(--line);border-color:var(--line);color:var(--ink);font-weight:700;}

  .sheet-progress-track{height:4px;background:var(--ink3);margin:10px 0 14px;border-radius:2px;overflow:hidden;}
  .sheet-progress-fill{height:100%;background:var(--line);}
  .sheet-progress-label{font-family:'Montserrat';font-size:10px;color:var(--paper-dim);letter-spacing:0.35px;}

  /* ---- course viewer ---- */
  .cv-tabs{display:flex;gap:2px;border-bottom:1px solid var(--line-dim);margin:16px 0 0;overflow-x:auto;}
  .cv-tab{background:none;border:none;color:var(--paper-dim);font-family:'Montserrat';font-size:11px;letter-spacing:0.7px;text-transform:uppercase;padding:12px 18px;border-bottom:2px solid transparent;white-space:nowrap;cursor:pointer;}
  .cv-tab.active{color:var(--line);border-color:var(--line);}
  .cv-tab:disabled{opacity:.3;cursor:default;}
  .cv-zoom{display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;background:linear-gradient(90deg, rgba(29,155,255,.12), rgba(29,155,255,.02));border:1px solid var(--line-dim);border-left:3px solid var(--line);padding:13px 18px;margin:18px 0;}
  .cv-zoom .zl{display:flex;align-items:center;gap:10px;font-family:'Montserrat';font-size:13px;font-weight:600;color:var(--paper);}
  .cv-zoom .zl svg{width:18px;height:18px;color:var(--line);flex-shrink:0;}
  .cv-layout{display:flex;gap:22px;align-items:flex-start;margin-top:16px;}
  .cv-player-col{flex:1;min-width:0;}
  .cv-side{width:300px;flex-shrink:0;background:var(--ink2);border:1px solid var(--line-dim);}
  .cv-side-head{padding:14px 18px;border-bottom:1px solid var(--line-dim);}
  .cv-side-head .t{font-family:'Montserrat';font-size:10.5px;letter-spacing:0.7px;text-transform:uppercase;color:var(--paper-dim);}
  .cv-side-head .pct{font-family:'Montserrat';font-weight:700;font-size:22px;color:var(--line);margin-top:4px;}
  .cv-side-track{height:4px;background:var(--ink3);margin-top:8px;border-radius:2px;overflow:hidden;}
  .cv-side-fill{height:100%;background:var(--line);}
  .cv-modlist{max-height:430px;overflow-y:auto;display:flex;flex-direction:column;gap:2px;padding:8px;}
  .cv-less-check{width:15px;height:15px;flex-shrink:0;color:var(--success);}
  @media (max-width:980px){
    .client-shell{flex-direction:column;align-items:stretch;}
    .client-sidebar{width:100%;position:static;display:flex;overflow-x:auto;}
    .client-sidebar .csb-user{display:none;}
    .client-sidebar .csb-group{display:flex;padding:10px;gap:4px;white-space:nowrap;}
    .client-sidebar .csb-label{display:none;}
    .csb-item{border-left:none;border-bottom:2px solid transparent;padding:8px 14px;width:auto;}
    .csb-item.active{border-left:none;border-bottom-color:var(--line);background:none;}
    .cv-layout{flex-direction:column;align-items:stretch;}
    .cv-side{width:100%;}
    .cv-modlist{max-height:none;}
  }

  .sheet-img{margin:-20px -20px 12px;height:110px;background-size:cover;background-position:center;border-bottom:1px solid var(--line-dim);}
  .sheet-img.placeholder{display:flex;align-items:center;justify-content:center;background:repeating-linear-gradient(45deg, var(--ink3) 0 2px, transparent 2px 14px);}
  .sheet-img.placeholder span{font-family:'Montserrat';font-size:13px;letter-spacing:1px;color:var(--line);opacity:.5;}

  .access-select{background:var(--ink);border:1px solid var(--line-dim);color:var(--paper);font-family:'Montserrat';font-size:11px;padding:6px 8px;border-radius:var(--radius);}
  .eye-toggle{cursor:pointer;font-size:18px;user-select:none;}
  .cert-modal-overlay{position:fixed;inset:0;background:rgba(6,14,24,0.85);display:flex;align-items:center;justify-content:center;z-index:200;padding:20px;}
  .cert-modal-box{position:relative;max-width:420px;width:100%;}
  .cert-modal-actions{position:absolute;top:10px;right:10px;display:flex;gap:6px;}
  .cert-modal-actions button{width:30px;height:30px;border-radius:50%;border:none;display:flex;align-items:center;justify-content:center;font-size:14px;font-weight:700;cursor:pointer;}

  .social-row{display:flex;gap:12px;}
  .social-row a{
    width:36px;height:36px;border:1px solid var(--line-dim);border-radius:50%;
    display:flex;align-items:center;justify-content:center;transition:border-color .15s;
  }
  .social-row a:hover{border-color:var(--line);}
  .social-row svg{width:16px;height:16px;fill:var(--paper-dim);}

  .promo-strip{display:flex;gap:16px;overflow-x:auto;padding-bottom:6px;}
  .promo-strip img{height:160px;width:auto;border:1px solid var(--line-dim);flex-shrink:0;}

  .project-card{background:var(--ink2);border:1px solid var(--line-dim);}
  .project-card img{width:100%;height:170px;object-fit:cover;display:block;border-bottom:1px solid var(--line-dim);}
  .project-card .project-body{padding:16px;}
  .project-card h3{font-size:16px;font-weight:700;line-height:1.25;margin-bottom:6px;}
  .project-card .project-loc{font-family:'Montserrat';font-size:10.5px;color:var(--line);letter-spacing:0.35px;margin-bottom:8px;}
  .project-card p{font-size:13px;color:var(--paper-dim);line-height:1.5;}

  /* ---- dashboard ---- */
  .dash{padding:110px 0 72px;min-height:70vh;}
  .dash-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;flex-wrap:wrap;gap:14px;}
  .dash-head .who{font-family:'Montserrat';font-size:12px;color:var(--paper-dim);}
  .dash-head .who b{color:var(--line);}
  .role-pill{font-family:'Montserrat';font-size:10.5px;letter-spacing:0.7px;border:1px solid var(--line);color:var(--line);padding:3px 8px;margin-left:8px;}

  .admin-tabs{display:flex;gap:10px;margin:28px 0 24px;border-bottom:1px solid var(--line-dim);overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;}
  .admin-tabs::-webkit-scrollbar{display:none;}
  .admin-tab{background:none;border:none;color:var(--paper-dim);padding:10px 4px;font-size:14px;font-weight:600;border-bottom:2px solid transparent;margin-right:20px;flex:none;white-space:nowrap;}
  .admin-tab.active{color:var(--paper);border-color:var(--line);}

  table{width:100%;border-collapse:collapse;font-size:13.5px;}
  th{text-align:left;font-family:'Montserrat';font-size:11px;letter-spacing:0.7px;color:var(--paper-dim);text-transform:uppercase;padding:10px 12px;border-bottom:1px solid var(--line-dim);}
  td{padding:12px;border-bottom:1px solid var(--line-dim);vertical-align:top;}
  .client-row td{color:var(--paper-dim);}
  .toggle-list{display:flex;flex-wrap:wrap;gap:8px;}
  .toggle-chip{
    font-family:'Montserrat';font-size:11px;border:1px solid var(--line-dim);
    padding:5px 10px;color:var(--paper-dim);background:none;
  }
  .toggle-chip.on{border-color:var(--success);color:var(--success);background:rgba(18,112,79,0.08);}

  .panel{background:var(--ink2);border:1px solid var(--line-dim);padding:24px;margin-bottom:20px;}
  .panel h3{font-size:16px;font-weight:700;margin-bottom:16px;}
  .row2{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;}
  @media(max-width:640px){.row2,.row3{grid-template-columns:1fr;}}

  .empty{color:var(--paper-dim);font-family:'Montserrat';font-size:13px;padding:30px 0;text-align:center;border:1px dashed var(--line-dim);}
  .table-scroll{width:100%;overflow-x:auto;-webkit-overflow-scrolling:touch;}

  /* content viewer */
  .content-view{background:var(--ink);border:1px solid var(--line);padding:20px;margin-top:10px;font-size:13.5px;color:var(--paper-dim);line-height:1.6;}
  .lesson-layout{display:flex;gap:16px;margin-top:12px;align-items:flex-start;}
  .lesson-sidebar{width:210px;flex-shrink:0;display:flex;flex-direction:column;gap:6px;max-height:360px;overflow-y:auto;}
  .lesson-item{
    text-align:left;background:none;border:1px solid var(--line-dim);color:var(--paper-dim);
    padding:10px 12px;font-size:12px;border-radius:var(--radius);line-height:1.35;
  }
  .lesson-item.active{border-color:var(--line);color:var(--paper);background:rgba(29,155,255,0.1);}
  .lesson-item{display:block;width:100%;}
  .lesson-progress-track{display:block;height:3px;background:var(--ink3);margin-top:6px;border-radius:2px;overflow:hidden;}
  .lesson-progress-fill{display:block;height:100%;background:var(--line);}
  .lesson-player{flex:1;min-width:0;}
  @media(max-width:680px){
    .lesson-layout{flex-direction:column;}
    .lesson-sidebar{width:100%;max-height:none;flex-direction:row;flex-wrap:wrap;}
    .lesson-item{flex:1 1 auto;}
  }
  .content-view b{color:var(--paper);}

  @media (prefers-reduced-motion: reduce){*{transition:none !important;scroll-behavior:auto !important;}}

  /* ---- responsive nav (mobile) ---- */
  @media(max-width:780px){
    .navbar{flex-wrap:wrap;position:relative;}
    .menu-toggle{display:block;}
    nav{
      display:none;width:100%;
      flex-direction:column;align-items:stretch;gap:14px;
      padding:18px 0 6px;margin-top:14px;
      border-top:1px solid var(--line-dim);
    }
    nav.open{display:flex;}
    nav a{padding:6px 0;}
    nav #nav-guest,nav #nav-user{display:flex;flex-direction:column;gap:10px;width:100%;}
    nav #nav-guest .btn,nav #nav-user .btn{width:100%;}
  }

  /* ---- tighter spacing on small screens ---- */
  @media(max-width:640px){
    .hero{padding:52px 0 36px;}
    .hero h1{font-size:clamp(26px,7.6vw,38px);}
    .hero p{font-size:14.5px;}
    .section{padding:44px 0;}
    .section-head h2{font-size:22px;}
    .dash{padding:96px 0 48px;}
    footer .wrap{flex-direction:column;align-items:flex-start;}
  }

  @media print{
    @page{ size: landscape; }
    body *{visibility:hidden;}
    #cert-content, #cert-content *{visibility:visible;}
    #cert-content{position:fixed;top:0;left:0;width:100%;}
    .no-print{display:none !important;}
    .cert-page{page-break-after:always; break-after:page;}
    .cert-page:last-child{page-break-after:auto; break-after:auto;}
  }
  .cert-page{margin-bottom:20px;}

  /* ---- certificado en pantalla: la ventana se puede desplazar y se adapta al celular (no afecta la impresión) ---- */
  @media screen{
    #cert-overlay, .cert-modal-overlay{overflow-y:auto;align-items:flex-start;}
    #cert-overlay .modal, .cert-modal-box{margin:auto;}
  }
  @media screen and (max-width:560px){
    #cert-overlay, .cert-modal-overlay{padding:10px;}
    #cert-overlay .modal{padding:44px 10px 18px;}
    .cert-page{padding:26px 18px !important;}
    .cert-page .cert-title{font-size:clamp(22px,8vw,30px) !important;}
    .cert-page .cert-name{font-size:21px !important;}
    .cert-page .cert-course{font-size:14.5px !important;}
    .cert-page .cert-sign-row{flex-wrap:wrap;justify-content:center !important;gap:22px 16px !important;}
    .cert-page .cert-sign-row > div:nth-child(-n+2){flex:1 1 130px !important;}
  }
</style>
