function renderClient(){
  const grid = document.getElementById('client-grid');
  const filters = document.getElementById('client-filters');
  const statsRow = document.getElementById('client-stats-row');
  const granted = state.access[session.id] || [];
  const grantedCourses = state.courses.filter(c => granted.includes(c.id));
  const done = state.completions[session.id] || [];
  const completedCount = grantedCourses.filter(c => done.includes(c.id)).length;
  const inProgressCount = grantedCourses.filter(c => !done.includes(c.id) && courseProgressPct(c.id) > 0).length;

  statsRow.classList.remove('hidden');
  statsRow.innerHTML = `
    <div class="cstat"><b>${grantedCourses.length}</b><span>Cursos habilitados</span></div>
    <div class="cstat"><b>${inProgressCount}</b><span>En progreso</span></div>
    <div class="cstat"><b>${completedCount}</b><span>Completados</span></div>
  `;

  if(grantedCourses.length === 0){
    filters.innerHTML = '';
    grid.innerHTML = `<div class="empty">Todavía no tienes cursos habilitados. Solicita acceso a tu asesor.</div>`;
    return;
  }

  const categories = [...new Set(grantedCourses.map(c => c.category).filter(Boolean))];
  filters.innerHTML = categories.length > 1
    ? [`<button class="cf-pill ${clientCourseFilter==='all'?'active':''}" onclick="setClientCourseFilter('all')">Todos</button>`]
        .concat(categories.map(cat => `<button class="cf-pill ${clientCourseFilter===cat?'active':''}" onclick="setClientCourseFilter('${escapeHtml(cat)}')">${escapeHtml(cat)}</button>`))
        .join('')
    : '';

  const visibleCourses = clientCourseFilter === 'all' ? grantedCourses : grantedCourses.filter(c => c.category === clientCourseFilter);

  grid.innerHTML = visibleCourses.map(c => {
    const pct = courseProgressPct(c.id);
    const isDone = done.includes(c.id);
    return `
    <div class="sheet"><div class="tick-bl"></div><div class="tick-br"></div>
      ${c.image_url ? `<div class="sheet-img" style="background-image:url('${escapeHtml(c.image_url)}')"></div>` : `<div class="sheet-img placeholder"><span>${escapeHtml(c.code)}</span></div>`}
      ${c.category ? `<span class="tag-chip">${escapeHtml(c.category)}</span>` : ''}
      <div class="sheet-code mono">${escapeHtml(c.code)}</div>
      <h3>${escapeHtml(c.title)}</h3>
      <div class="title-block">
        <span><b>${escapeHtml(c.hours)}</b></span>
        <span>${escapeHtml(c.instructor)}</span>
      </div>
      <div class="sheet-progress-track"><div class="sheet-progress-fill" style="width:${pct}%"></div></div>
      <div class="sheet-progress-label">${isDone ? 'COMPLETADO' : pct+'% AVANZADO'}</div>
      <button class="btn btn-solid btn-sm" style="margin:14px 0;width:100%;" onclick="openClientCourseDetail('${c.id}')">Ver curso</button>
    </div>`;
  }).join('');
}

