function normWa(v){
  let d = String(v == null ? '' : v).replace(/\D/g,'').replace(/^0+/,'');
  if(d.length === 9 && d.charAt(0) === '9') d = '51' + d;   // celular peruano escrito sin el 51
  return (d.length >= 8 && d.length <= 15) ? d : '';
}
function fmtWa(d){
  if(!d) return '';
  return /^51\d{9}$/.test(d) ? `+51 ${d.slice(2,5)} ${d.slice(5,8)} ${d.slice(8)}` : '+' + d;
}

