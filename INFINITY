        const selectedId = adminSelectedCourse[u.id] || '';
        return `<tr class="client-row">
          <td style="color:var(--paper)">${escapeHtml(u.name)}</td>
          <td class="mono">${escapeHtml(u.email)}</td>
          <td>
            <div style="display:flex;align-items:center;gap:10px;">
              <select class="access-select" id="course-sel-${u.id}" onchange="onAdminCourseChange('${u.id}')">
                ${state.courses.map(c => `<option value="${c.id}" ${c.id===selectedId?'selected':''}>${escapeHtml(c.code)}</option>`).join('')}
              </select>
              <span class="eye-toggle" id="access-eye-${u.id}" onclick="toggleAccessFromSelect('${u.id}')" title="Dar/quitar acceso al curso seleccionado"></span>
            </div>
          </td>
          <td><span class="eye-toggle" id="cert-eye-${u.id}" onclick="openCertPreviewModal('${u.id}')" title="Vista previa del certificado del curso seleccionado"></span></td>
        </tr>`;
      }).join('')}
    </tbody></table></div>`;
    state.clients.forEach(u => { renderAccessEyeIcon(u.id); renderCertEyeIcon(u.id); });
  }

  const coursesWrap = document.getElementById('courses-table-wrap');
  coursesWrap.innerHTML = `<h3>Cursos publicados</h3><div class="table-scroll"><table><thead><tr><th>Código</th><th>Título</th><th>Categoría</th><th>Horas</th><th>Instructor</th><th></th></tr></thead><tbody>
    ${state.courses.map(c => `<tr>
      <td class="mono">${escapeHtml(c.code)}</td>
      <td style="color:var(--paper)">${escapeHtml(c.title)}</td>
      <td>${escapeHtml(c.category||'—')}</td>
      <td>${escapeHtml(c.hours)}</td>
      <td>${escapeHtml(c.instructor)}</td>
      <td style="white-space:nowrap;"><button class="btn btn-ghost btn-sm" onclick="openLessonManager('${c.id}')">Clases</button> <button class="btn btn-danger btn-sm" onclick="deleteCourse('${c.id}')">Eliminar</button></td>
    </tr>`).join('')}
  </tbody></table></div>`;
}

function onAdminCourseChange(clientId){
  const sel = document.getElementById('course-sel-'+clientId);
  adminSelectedCourse[clientId] = sel.value;
  renderAccessEyeIcon(clientId);
  renderCertEyeIcon(clientId);
}

function renderAccessEyeIcon(clientId){
  const el = document.getElementById('access-eye-'+clientId);
  if(!el) return;
  const courseId = adminSelectedCourse[clientId];
  const has = (state.access[clientId]||[]).includes(courseId);
  el.innerHTML = has ? ICON_EYE : ICON_EYE_OFF;
  el.style.color = has ? 'var(--line)' : 'var(--paper-dim)';
}

function renderCertEyeIcon(clientId){
  const el = document.getElementById('cert-eye-'+clientId);
  if(!el) return;
  const courseId = adminSelectedCourse[clientId];
  const info = (state.certified[clientId]||{})[courseId];
  if(!info){ el.innerHTML = ICON_EYE_OFF; el.style.color = 'var(--paper-dim)'; el.style.cursor = 'default'; return; }
  el.style.cursor = 'pointer';
  el.innerHTML = ICON_EYE;
  el.style.color = info.status === 'approved' ? 'var(--success)' : 'var(--signal)';
}

async function toggleAccessFromSelect(clientId){
  const courseId = adminSelectedCourse[clientId];
  if(!courseId) return;
  const list = state.access[clientId] || [];
  const has = list.includes(courseId);
  if(has){
    await sb.from('course_access').delete().eq('user_id', clientId).eq('course_id', courseId);
  } else {
    await sb.from('course_access').insert({ user_id: clientId, course_id: courseId });
  }
  await loadAdminData();
  renderAdmin();
}

function openCertPreviewModal(clientId){
  const courseId = adminSelectedCourse[clientId];
  const info = (state.certified[clientId]||{})[courseId];
  if(!info) return;
  const client = state.clients.find(c => c.id === clientId);
  const c = state.courses.find(x => x.id === courseId);
  const dateStr = info.completed_at ? new Date(info.completed_at).toLocaleDateString('es-PE', { year:'numeric', month:'long', day:'numeric' }) : '';
  const { html } = buildCertificateHTML(client.name, c.title, c.code, c.hours, dateStr, info.code, [], c.instructor);

  const overlay = document.createElement('div');
  overlay.className = 'cert-modal-overlay';
  overlay.id = 'admin-cert-overlay';
  overlay.innerHTML = `
    <div class="cert-modal-box">
      <div style="text-align:center;margin-bottom:8px;font-family:'Montserrat',sans-serif;font-size:11px;letter-spacing:1px;color:${info.status==='approved' ? '#3FA796' : '#F2A900'};">${info.status==='approved' ? 'APROBADO — VISIBLE PARA EL CLIENTE' : 'PENDIENTE DE APROBACIÓN'}</div>
      <div class="cert-modal-actions">
        <button style="background:var(--paper);color:var(--ink);" onclick="window.print()" title="Descargar / imprimir">↓</button>
        <button style="background:var(--success);color:#fff;" onclick="approveCertFromModal('${clientId}','${courseId}')" title="Aprobar">✓</button>
        <button style="background:var(--signal);color:#fff;" onclick="closeCertPreviewModal()" title="Cerrar">✕</button>
      </div>
      ${html}
      <div class="no-print" style="text-align:center;margin-top:14px;">
        <button class="btn btn-danger btn-sm" onclick="revokeCertFromModal('${clientId}','${courseId}')">Revocar certificado</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
}

function closeCertPreviewModal(){
  const el = document.getElementById('admin-cert-overlay');
  if(el) el.remove();
}

async function approveCertFromModal(clientId, courseId){
  const { error } = await sb.from('completions').update({ status: 'approved' }).eq('user_id', clientId).eq('course_id', courseId);
  if(error){ alert('No se pudo aprobar: ' + error.message); return; }
  closeCertPreviewModal();
  await loadAdminData();
  renderAdmin();
}

async function revokeCertFromModal(clientId, courseId){
  if(!confirm('¿Quitar este certificado? El cliente tendrá que generarlo de nuevo después de ver todas las clases.')) return;
  await sb.from('completions').delete().eq('user_id', clientId).eq('course_id', courseId);
  closeCertPreviewModal();
  await loadAdminData();
  renderAdmin();
}

function renderCategoriesAdmin(){
  const list = document.getElementById('categories-list');
  if(list){
    list.innerHTML = state.categories.length === 0
      ? `<div class="empty">Sin categorías todavía.</div>`
      : `<div class="toggle-list">${state.categories.map(c => `<span class="tag-chip" style="display:inline-flex;align-items:center;gap:6px;margin-right:6px;">${escapeHtml(c.name)}<button onclick="deleteCategory('${c.id}')" style="background:none;border:none;color:var(--signal);cursor:pointer;font-size:12px;padding:0;">×</button></span>`).join('')}</div>`;
  }
  const sel = document.getElementById('nc-category');
  if(sel){
    const cur = sel.value;
    sel.innerHTML = '<option value="">Sin categoría</option>' + state.categories.map(c => `<option value="${escapeHtml(c.name)}">${escapeHtml(c.name)}</option>`).join('');
    sel.value = cur;
  }
}

async function createCategory(){
  const input = document.getElementById('cat-new');
  const name = input.value.trim();
  const msg = document.getElementById('cat-msg');
  if(!name){ msg.textContent = 'Escribe un nombre.'; msg.className = 'form-msg err'; return; }
  const { error } = await sb.from('categories').insert({ name });
  if(error){ msg.textContent = 'Error: ' + error.message; msg.className = 'form-msg err'; return; }
  input.value = '';
  msg.textContent = 'Categoría agregada.';
  msg.className = 'form-msg ok';
  const { data: cats } = await sb.from('categories').select('*').order('name');
  state.categories = cats || [];
  renderCategoriesAdmin();
}

async function deleteCategory(id){
  await sb.from('categories').delete().eq('id', id);
  const { data: cats } = await sb.from('categories').select('*').order('name');
  state.categories = cats || [];
  renderCategoriesAdmin();
}

async function createCourse(){
  const code = document.getElementById('nc-code').value.trim();
  const title = document.getElementById('nc-title').value.trim();
  const hours = document.getElementById('nc-hours').value.trim();
  const instructor = document.getElementById('nc-instructor').value.trim();
  const desc = document.getElementById('nc-desc').value.trim();
  const category = document.getElementById('nc-category').value.trim();
  const image = document.getElementById('nc-image').value.trim();
  const msg = document.getElementById('nc-msg');
  if(!code || !title){
    msg.textContent = 'Código y título son obligatorios.';
    msg.className = 'form-msg err';
    return;
  }
  const { error } = await sb.from('courses').insert({
    code, title, hours: hours || '—', instructor: instructor || '—', description: desc || 'Sin descripción.',
    category: category || null, image_url: image || null
  });
  if(error){
    msg.textContent = 'Error al publicar: ' + error.message;
    msg.className = 'form-msg err';
    return;
  }
  ['nc-code','nc-title','nc-hours','nc-instructor','nc-desc','nc-category','nc-image'].forEach(id => document.getElementById(id).value = '');
  msg.textContent = 'Curso publicado. Ahora agrégale clases con el botón "Clases".';
  msg.className = 'form-msg ok';
  await loadAdminData();
  renderAdmin();
}

async function deleteCourse(id){
  await sb.from('courses').delete().eq('id', id);
  if(manageCourseId === id) closeLessonManager();
  await loadAdminData();
  renderAdmin();
}

/* ---------------- PROYECTOS (admin) ---------------- */
function renderProjectsAdmin(){
  const wrap = document.getElementById('projects-table-wrap');
  if(state.projects.length === 0){
    wrap.innerHTML = `<div class="empty">Sin proyectos todavía.</div>`;
    return;
  }
  wrap.innerHTML = `<h3>Proyectos publicados</h3><div class="table-scroll"><table><thead><tr><th>Título</th><th>Ubicación</th><th></th></tr></thead><tbody>
    ${state.projects.map(p => `<tr>
      <td style="color:var(--paper)">${escapeHtml(p.title)}</td>
      <td>${escapeHtml(p.location||'—')}</td>
      <td><button class="btn btn-danger btn-sm" onclick="deleteProject('${p.id}')">Eliminar</button></td>
    </tr>`).join('')}
  </tbody></table></div>`;
}

async function createProject(){
  const title = document.getElementById('pj-title').value.trim();
  const location = document.getElementById('pj-location').value.trim();
  const desc = document.getElementById('pj-desc').value.trim();
  const image = document.getElementById('pj-image').value.trim();
  const msg = document.getElementById('pj-msg');
  if(!title){ msg.textContent = 'El título es obligatorio.'; msg.className = 'form-msg err'; return; }
  const order = state.projects.length;
  const { error } = await sb.from('projects').insert({ title, location: location||null, description: desc||null, image_url: image||null, order_index: order });
  if(error){ msg.textContent = 'Error: ' + error.message; msg.className = 'form-msg err'; return; }
  ['pj-title','pj-location','pj-desc','pj-image'].forEach(id => document.getElementById(id).value = '');
  msg.textContent = 'Proyecto publicado.';
  msg.className = 'form-msg ok';
  await loadProjects();
  renderProjectsAdmin();
  renderProjects();
}

async function deleteProject(id){
  await sb.from('projects').delete().eq('id', id);
  await loadProjects();
  renderProjectsAdmin();
  renderProjects();
}

/* ---------------- PROMOCIONES (admin) ---------------- */
function renderPromosAdmin(){
  const wrap = document.getElementById('promos-table-wrap');
  if(state.promotions.length === 0){
    wrap.innerHTML = `<div class="empty">Sin promociones todavía.</div>`;
    return;
  }
  wrap.innerHTML = `<h3>Promociones publicadas</h3><div class="table-scroll"><table><thead><tr><th>Imagen</th><th>Enlace</th><th></th></tr></thead><tbody>
    ${state.promotions.map(p => `<tr>
      <td class="mono" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${escapeHtml(p.image_url)}</td>
      <td>${p.link_url ? escapeHtml(p.link_url) : '—'}</td>
      <td><button class="btn btn-danger btn-sm" onclick="deletePromotion('${p.id}')">Eliminar</button></td>
    </tr>`).join('')}
  </tbody></table></div>`;
}

async function createPromotion(){
  const fileInput = document.getElementById('pm-image');
  const file = fileInput.files[0];
  const link = document.getElementById('pm-link').value.trim();
  const msg = document.getElementById('pm-msg');
  if(!file){ msg.textContent = 'Selecciona una imagen.'; msg.className = 'form-msg err'; return; }
  msg.textContent = 'Subiendo imagen…';
  msg.className = 'form-msg';
  const path = `${Date.now()}-${file.name}`.replace(/\s+/g, '-');
  const { error: upErr } = await sb.storage.from('flyers').upload(path, file);
  if(upErr){ msg.textContent = 'Error al subir la imagen: ' + upErr.message; msg.className = 'form-msg err'; return; }
  const { data: urlData } = sb.storage.from('flyers').getPublicUrl(path);
  const order = state.promotions.length;
  const { error } = await sb.from('promotions').insert({ image_url: urlData.publicUrl, link_url: link||null, order_index: order });
  if(error){ msg.textContent = 'Error: ' + error.message; msg.className = 'form-msg err'; return; }
  fileInput.value = '';
  document.getElementById('pm-link').value = '';
  msg.textContent = 'Promoción publicada.';
  msg.className = 'form-msg ok';
  await loadPromotions();
  renderPromosAdmin();
  renderPromotions();
}

async function deletePromotion(id){
  await sb.from('promotions').delete().eq('id', id);
  await loadPromotions();
  renderPromosAdmin();
  renderPromotions();
}

/* ---------------- LESSON MANAGER (admin) ---------------- */
function openLessonManager(courseId){
  manageCourseId = courseId;
  const c = state.courses.find(x=>x.id===courseId);
  document.getElementById('lm-course-title').textContent = 'Clases de: ' + (c ? c.title : '');
  document.getElementById('lessons-manager').classList.remove('hidden');
  document.getElementById('lessons-manager').scrollIntoView({behavior:'smooth'});
  loadAndRenderLessons();
}
function closeLessonManager(){
  manageCourseId = null;
  document.getElementById('lessons-manager').classList.add('hidden');
}

function sessionLabel(index){
  return 'SESIÓN ' + String(index+1).padStart(2,'0');
}

async function loadAndRenderLessons(){
  const list = document.getElementById('lm-list');
  const { data: lessons } = await sb.from('course_lessons').select('*').eq('course_id', manageCourseId).order('order_index');
  const nextLabelEl = document.getElementById('lm-next-label');
  if(nextLabelEl) nextLabelEl.textContent = sessionLabel((lessons||[]).length) + ' (siguiente)';

  if(!lessons || lessons.length === 0){
    list.innerHTML = `<div class="empty">Sin clases todavía.</div>`;
    return;
  }

  const { data: accessRows } = await sb.from('course_access').select('user_id').eq('course_id', manageCourseId);
  const clientIds = (accessRows||[]).map(r=>r.user_id);
  const clients = state.clients.filter(c => clientIds.includes(c.id));

  const lessonIds = lessons.map(l=>l.id);
  let laMap = {};
  if(clients.length > 0){
    const { data: laRows } = await sb.from('lesson_access').select('*').in('lesson_id', lessonIds);
    (laRows||[]).forEach(r => {
      if(!laMap[r.lesson_id]) laMap[r.lesson_id] = [];
      laMap[r.lesson_id].push(r.user_id);
    });
  }

  const { data: matRows } = await sb.from('lesson_materials').select('*').in('lesson_id', lessonIds).order('created_at');
  const matMap = {};
  (matRows||[]).forEach(r => {
    if(!matMap[r.lesson_id]) matMap[r.lesson_id] = [];
    matMap[r.lesson_id].push(r);
  });

  list.innerHTML = lessons.map((l,i) => {
    const granted = laMap[l.id] || [];
    const materials = matMap[l.id] || [];
    const accessHtml = clients.length === 0
      ? `<div style="font-size:11px;color:var(--paper-dim);font-family:'Montserrat';margin-bottom:10px;">Aún ningún cliente tiene acceso a este curso — dales acceso en "Clientes y accesos" para poder habilitarles esta clase.</div>`
      : `<div class="toggle-list" style="margin-bottom:10px;">
          ${clients.map(c => `<button class="toggle-chip ${granted.includes(c.id)?'on':''}" onclick="toggleLessonAccess('${c.id}','${l.id}')">${granted.includes(c.id)?'✓ ':''}${escapeHtml(c.name || c.email)}</button>`).join('')}
        </div>`;
    const materialsHtml = materials.length === 0
      ? `<div style="font-size:11px;color:var(--paper-dim);margin-bottom:8px;">Sin material todavía.</div>`
      : `<div style="display:flex;flex-direction:column;gap:6px;margin-bottom:8px;">
          ${materials.map(m => `<div style="display:flex;justify-content:space-between;align-items:center;font-size:11.5px;">
            <span class="mono" style="color:var(--paper-dim);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:260px;">${escapeHtml(m.name || m.url)}</span>
            <button onclick="deleteMaterial('${m.id}', ${m.storage_path ? `'${escapeHtml(m.storage_path)}'` : 'null'})" style="background:none;border:none;color:var(--signal);cursor:pointer;font-size:14px;padding:0 4px;">×</button>
          </div>`).join('')}
        </div>`;
    return `
    <div style="padding:10px 0;border-bottom:1px solid var(--line-dim);">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <span style="font-size:13px;color:var(--paper)">${sessionLabel(i)}: ${escapeHtml(l.tema)}</span>
        <button class="btn btn-danger btn-sm" onclick="deleteLesson('${l.id}')">Eliminar</button>
      </div>
      ${accessHtml}
      <div style="background:var(--ink);border:1px solid var(--line-dim);padding:10px;">
        <div style="font-family:'Montserrat';font-size:9.5px;color:var(--paper-dim);letter-spacing:.5px;margin-bottom:8px;">MATERIAL DE APOYO</div>
        ${materialsHtml}
        <div style="display:flex;gap:6px;flex-wrap:wrap;">
          <input id="mat-link-${l.id}" placeholder="Enlace (opcional)" style="flex:1;min-width:140px;background:var(--ink2);border:1px solid var(--line-dim);color:var(--paper);padding:7px 9px;font-size:11.5px;border-radius:var(--radius);">
          <input id="mat-file-${l.id}" type="file" style="flex:1;min-width:140px;font-size:11px;color:var(--paper-dim);">
          <button class="btn btn-ghost btn-sm" onclick="addMaterialToLesson('${l.id}')">Agregar archivo</button>
        </div>
        <div id="mat-msg-${l.id}" class="form-msg"></div>
      </div>
    </div>`;
  }).join('');
}

async function addMaterialToLesson(lessonId){
  const linkInput = document.getElementById('mat-link-'+lessonId);
  const fileInput = document.getElementById('mat-file-'+lessonId);
  const msg = document.getElementById('mat-msg-'+lessonId);
  const link = linkInput.value.trim();
  const file = fileInput.files[0];
  if(!link && !file){ msg.textContent = 'Pon un enlace o elige un archivo.'; msg.className = 'form-msg err'; return; }

  let url = link, storagePath = null, name = link;
  if(file){
    msg.textContent = 'Subiendo…';
    msg.className = 'form-msg';
    const path = `${Date.now()}-${file.name}`.replace(/\s+/g, '-');
    const { error: upErr } = await sb.storage.from('materials').upload(path, file);
    if(upErr){ msg.textContent = 'Error al subir: ' + upErr.message; msg.className = 'form-msg err'; return; }
    const { data: urlData } = sb.storage.from('materials').getPublicUrl(path);
    url = urlData.publicUrl;
    storagePath = path;
    name = file.name;
  }

  const { error } = await sb.from('lesson_materials').insert({ lesson_id: lessonId, name, url, storage_path: storagePath });
  if(error){ msg.textContent = 'Error: ' + error.message; msg.className = 'form-msg err'; return; }
  loadAndRenderLessons();
}

async function deleteMaterial(materialId, storagePath){
  if(storagePath){
    try{ await sb.storage.from('materials').remove([storagePath]); }catch(e){ console.error(e); }
  }
  await sb.from('lesson_materials').delete().eq('id', materialId);
  loadAndRenderLessons();
}

async function toggleLessonAccess(userId, lessonId){
  const { data } = await sb.from('lesson_access').select('*').eq('user_id', userId).eq('lesson_id', lessonId);
  const has = data && data.length > 0;
  if(has){
    await sb.from('lesson_access').delete().eq('user_id', userId).eq('lesson_id', lessonId);
  } else {
    await sb.from('lesson_access').insert({ user_id: userId, lesson_id: lessonId });
  }
  loadAndRenderLessons();
}

async function addLesson(){
  const tema = document.getElementById('lm-tema').value.trim();
  const video = document.getElementById('lm-video').value.trim();
  const msg = document.getElementById('lm-msg');
  if(!tema){ msg.textContent = 'Ponle un tema a la clase.'; msg.className = 'form-msg err'; return; }

  const { data: existing } = await sb.from('course_lessons').select('id').eq('course_id', manageCourseId);
  const order = existing ? existing.length : 0;
  const { error } = await sb.from('course_lessons').insert({ course_id: manageCourseId, tema, video_url: video, order_index: order });
  if(error){ msg.textContent = 'Error: ' + error.message; msg.className = 'form-msg err'; return; }
  document.getElementById('lm-tema').value = '';
  document.getElementById('lm-video').value = '';
  msg.textContent = 'Clase agregada — está bloqueada para todos hasta que le des acceso a cada cliente abajo.';
  msg.className = 'form-msg ok';
  loadAndRenderLessons();
}

async function deleteLesson(lessonId){
  await sb.from('course_lessons').delete().eq('id', lessonId);
  loadAndRenderLessons();
}

(async function init(){
  const params = new URLSearchParams(location.search);
  const verifyCode = params.get('verify');
  if(verifyCode){
    await renderVerify(verifyCode);
    return;
  }
  try{ await loadSession(); }catch(e){ console.error(e); session = null; }
  await renderAll();
  showVisitCount();
})();

</script>
</body>
