  if(!name || !email || pass.length < 6){
    msg.className = 'form-msg err';
    msg.textContent = 'Completa todos los campos (contraseña mínimo 6 caracteres).';
    return;
  }
  msg.className = 'form-msg';
  msg.textContent = 'Creando cuenta…';
  try{
    const { data, error } = await sb.auth.signUp({ email, password: pass, options: { data: { name } } });
    if(error){ msg.textContent = error.message; msg.className = 'form-msg err'; return; }
    if(!data.session){
      msg.textContent = 'Cuenta creada. Revisa tu correo para confirmar el acceso antes de ingresar.';
