function courseFullyWatched(courseId){
  const lessons = (state.lessons && state.lessons[courseId]) || [];
  if(lessons.length === 0) return false;
  return lessons.every(l => {
    const p = state.progress && state.progress[l.id];
    return p && p.duration > 0 && p.seconds >= p.duration * 0.9;
  });
}

async function requestCertificate(courseId){
  const code = genCertCode();
  const { error } = await sb.from('completions').insert({ user_id: session.id, course_id: courseId, certificate_code: code, status: 'pending' });
  if(error){ alert('No se pudo solicitar el certificado: ' + error.message); return; }
  await loadClientData();
  renderClientCourseDetail(courseId);
}

